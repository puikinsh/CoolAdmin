extends ../layouts/_default

block variables
  - var pageMeta = { "title": "Calendar", "description": "Event calendar built with FullCalendar 7 and Bootstrap 5 styling." }
  - var activePage = 'calendar.html'

block extra_head
  //- FullCalendar 7 ships its CSS as files (v6 injected it from JS).
  //- Order matters: skeleton → theme → palette (palette holds the color tokens).
  link(rel='stylesheet' href='vendor/fullcalendar-7.1.2/skeleton.css')
  link(rel='stylesheet' href='vendor/fullcalendar-7.1.2/themes/classic/theme.css')
  link(rel='stylesheet' href='vendor/fullcalendar-7.1.2/themes/classic/palette.css')
  include ../partials/content/calendar.styles.html

block content
  include ../partials/content/calendar.html

block vendor_scripts
  //- Core bundle first — the theme self-registers into FullCalendar.Shared.globalPlugins.
  script(src='vendor/fullcalendar-7.1.2/fullcalendar.global.min.js')
  script(src='vendor/fullcalendar-7.1.2/themes/classic/theme.global.min.js')

block extra_scripts
  include ../partials/content/calendar.scripts.html
